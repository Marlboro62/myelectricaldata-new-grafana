        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VICTORIAMETRICS}"
          },
          "expr": "last_over_time(electricity_stats_value_kwh{direction=\"consumption\",period=\"this_year\"}[1d])",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#43a047"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "Consommation journalière",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VICTORIAMETRICS}"
          },
          "expr": "electricity_consumption_value_kwh{granularity=\"daily\"}",
          "legendFormat": "kWh / jour",
          "refId": "A",
          "range": true,
          "instant": false,
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#43a047"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "timeFrom": "90d"
    },
    {
      "id": 7,
      "title": "Courbe de charge (puissance moyenne par demi-heure)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VICTORIAMETRICS}"
          },
          "expr": "electricity_consumption_value_wh{granularity=\"detailed\"} * 2",
          "legendFormat": "W moyens",
          "refId": "A",
          "range": true,
          "instant": false,
          "interval": "30m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter",
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e24aa"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "timeFrom": "7d"
    },
    {
      "id": 8,
      "title": "Consommation glissante sur 30 jours",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VICTORIAMETRICS}"
          },
          "expr": "sum_over_time(max_over_time(electricity_consumption_value_kwh{granularity=\"daily\"}[1d])[30d:1d])",
          "legendFormat": "kWh sur 30 jours",
          "refId": "A",
          "range": true,
          "instant": false,
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#fb8c00"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "timeFrom": "1y"
    },
    {
      "id": 9,
      "title": "Consommation de l'année par couleur Tempo",
